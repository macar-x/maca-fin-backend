# Environment

export TARGET_IMAGE_VERSION="demo"
export TZ=Asia/Shanghai

export MACA_FIN_DATABASE_CONTAINER="postgres"
# For host access (outside containers): use host.docker.internal with mapped port
export MACA_FIN_DATABASE_HOST="host.docker.internal"
export MACA_FIN_DATABASE_PORT="5432"
# For container-to-container communication: use container name with internal port
export MACA_FIN_DATABASE_HOST_INTERNAL="postgres"
export MACA_FIN_DATABASE_PORT_INTERNAL="5432"
export MACA_FIN_DATABASE_NAME="maca_fin"
export MACA_FIN_DATABASE_USERNAME="maca"
export MACA_FIN_DATABASE_PASSWORD="password"
export MACA_FIN_DATABASE_PERSIST_PATH="/data/postgres"

export MACA_FIN_BACKEND_DATABASE_NAME="maca_fin"
# Backend runs in container, use internal hostname
export MACA_FIN_BACKEND_DATABASE_JDBC_URL="jdbc:postgresql://${MACA_FIN_DATABASE_HOST_INTERNAL}:${MACA_FIN_DATABASE_PORT_INTERNAL}/${MACA_FIN_BACKEND_DATABASE_NAME}"
export MACA_FIN_BACKEND_PUBLIC_PORT="3306"
export MACA_FIN_BACKEND_DATA_PATH="/data"

export MACA_FIN_OIDC_SERVER_HTTP_PORT="5433"
export MACA_FIN_OIDC_SERVER_HTTPS_PORT="5434"
# For development (backend on host): use localhost with mapped port
export MACA_FIN_OIDC_SERVER_URI="http://127.0.0.1:${MACA_FIN_OIDC_SERVER_HTTP_PORT}"
# For production (backend in container): use container name with internal port
export MACA_FIN_OIDC_SERVER_URI_INTERNAL="http://keycloak:8080"
export MACA_FIN_OIDC_REALM_NAME="maca-fin"
export MACA_FIN_OIDC_REALM_CLIENT="backend"
export MACA_FIN_OIDC_REALM_SECRET="demo_secret"
export MACA_FIN_OIDC_ADMIN_USERNAME="maca"
export MACA_FIN_OIDC_ADMIN_PASSWORD="password"
